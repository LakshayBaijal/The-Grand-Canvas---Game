# Grand Canvas settings. Copy this file to ".env" (same folder) and fill it in.
# ".env" is ignored by git, so your real values never get pushed.
#
# Who reads what:
#   the server (start-server.bat / start-server.sh, and the deployed server)
#     reads PORT, DB_PATH, GOOGLE_CLIENT_ID
#   build-app.ps1 (builds the APK / app bundle for the Play Store)
#     reads SERVER, GOOGLE_SERVER_CLIENT_ID
#   the "Links" section is only for you, so everything is in one place.

# ---- Server -----------------------------------------------------------------

# Port the server listens on. Leave 8090 unless something else is using it.
PORT=8090

# Where the SQLite database file lives. Players, drawings, hearts, hall of
# fame: everything is in this one file. On the VM this is an absolute path
# on the VM's disk; on your laptop the default is fine.
DB_PATH=data/leaderboard.db

# Google sign-in (optional). The *Web* OAuth client id from Google Cloud
# Console -> APIs & Services -> Credentials. Looks like
# 123456789012-abcdefghijklmnop.apps.googleusercontent.com
# Leave empty and the game runs on device accounts only.
GOOGLE_CLIENT_ID=

# ---- App build --------------------------------------------------------------

# Where the app connects. A bare host name means secure (wss://) automatically;
# a bare IP or "localhost" means plain ws:// (for playing on your own Wi-Fi).
#   your VM's name:   grandcanvas.duckdns.org
#   your laptop:      192.168.1.10:8090
SERVER=

# The same Web client id as GOOGLE_CLIENT_ID above. The app sends it to
# Google so the token it gets back is one this server will accept.
GOOGLE_SERVER_CLIENT_ID=

# ---- Links (for you; nothing reads these) -----------------------------------

# Oracle Cloud console, and the VM's public IP once it exists.
ORACLE_CONSOLE_URL=https://cloud.oracle.com/
VM_PUBLIC_IP=
# The SSH key that gets you into the VM (the private key file on your laptop).
SSH_KEY_PATH=

# DuckDNS (free domain name for the VM). Your account page and your token.
DUCKDNS_URL=https://www.duckdns.org/domains
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Google Cloud project for sign-in.
GOOGLE_CLOUD_CREDENTIALS_URL=https://console.cloud.google.com/apis/credentials

# Google Play Console.
PLAY_CONSOLE_URL=https://play.google.com/console/

# The upload keystore for signing the app. NEVER lose this file or its
# passwords; keep a copy somewhere that isn't this laptop.
KEYSTORE_PATH=
KEYSTORE_BACKUP_LOCATION=

# The GitHub repo.
GITHUB_REPO_URL=https://github.com/LakshayBaijal/The-Grand-Canvas---Game
